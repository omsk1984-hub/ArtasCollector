<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ArtasChartRoot>$(MSBuildThisFileDirectory)</ArtasChartRoot>

    <!--
      NuGet Audit отключён: сборка/окружение работает в офлайн-режиме и не имеет
      доступа к индексу уязвимостей nuget.org, из-за чего шло предупреждение
      NU1900 на каждый проект. Audit вернуть можно, если появится сетевой доступ.
    -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
