<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ArtasChart.App.Views.FractalChartControl">
    <Grid RowDefinitions="*,220" Margin="0">

        <!-- Основной график фракталов: линия + точки -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="0">
            <sp:AvaPlot Name="MainPlot" />
        </Border>

        <!-- Гистограмма From Start Interest -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="0">
            <sp:AvaPlot Name="HistPlot" />
        </Border>

    </Grid>
</UserControl>
