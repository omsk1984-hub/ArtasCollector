{
  "Db": {
    "Host": "127.0.0.1",
    "Port": 5432,
    "Database": "artas_db",
    "User": "artas_user",
    "Password": "artas_password"
  },
  "Finam": {
    "BaseUrl": "https://api.finam.ru",
    "GrpcUrl": "https://api.finam.ru",
    "WsUrl": "wss://api.finam.ru/ws",
    "Token": "",
    "Transport": "gRPC",
    "DefaultMic": "RTSX",
    "ReconnectDelayMs": 5000,
    "StreamMaxRetries": 3,
    "ReauthOnRetry": true,
    "AuthRefreshMinutes": 50,
    "SimulationMode": false
  },
  "Writer": {
    "Symbols": [
      { "Name": "Si" },
      { "Name": "MX" },
      { "Name": "IMOEXF" },
      { "Name": "CNY" },
      { "Name": "USDRUBF" },
      { "Name": "CNYRUBF" },
      { "Name": "MM" },
      { "Name": "RI" }
    ],
    "HealthPort": 8080,
    "ProducerChannelCapacity": 10000,
    "WriterChannelCapacity": 10000,
    "WriteBatchSize": 100,
    "WriteFlushIntervalMs": 1000,
    "FractalBufferSize": 500,
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "Microsoft.AspNetCore.Http.Result.JsonResult": "Warning"
    }
  }
}
