{
  // ── Подключение к PostgreSQL ───────────────────────────────────────────────
  // Секция "Db" → ArtasCore.Data.DbConfig.
  // Поддерживаются плоские ключи-env: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
  "Db": {
    // Хост PostgreSQL. Рекомендуется IPv4 (127.0.0.1): PG в WSL слушает только IPv4.
    "Host": "127.0.0.1",
    // Порт PostgreSQL.
    "Port": 5432,
    // Имя базы данных.
    "Database": "artas_db",
    // Пользователь БД.
    "User": "artas_user",
    // Пароль БД.
    "Password": "artas_password"
  },

  // ── Подключение к Finam API ────────────────────────────────────────────────
  // Секция "Finam" → ArtasWriter.FinamApi.Options.FinamOptions.
  "Finam": {
    // Базовый URL REST API Finam.
    "BaseUrl": "https://api.finam.ru",
    // URL gRPC-эндпоинта (основной транспорт приёма тиков).
    "GrpcUrl": "https://api.finam.ru",
    // URL WebSocket-эндпоинта (альтернативный транспорт).
    "WsUrl": "wss://api.finam.ru/ws",
    // Секретный ключ Finam (secret key, tapi_sk_...). Обменивается на JWT через AuthService.Auth.
    "Token": "ВСТАВЬТЕ_ТОКЕН_FINAM",
    // Транспорт: "gRPC" (по умолчанию) или "WebSocket".
    "Transport": "gRPC",
    // Задержка переподключения, мс.
    "ReconnectDelayMs": 5000,
    // Максимум последовательных неудачных попыток переподключения одного стрима.
    // По исчерпании лимита проблемный стрим останавливается (остальные живут),
    // в /health символ помечается finam_connected=false со статусом degraded.
    "StreamMaxRetries": 3,
    // Пробовать повторную авторизацию (Auth) при сбое стрима (обновляет общий JWT).
    "ReauthOnRetry": true,
    // Период планового обновления JWT фоновым auth-keepalive, минуты.
    "AuthRefreshMinutes": 50,
    // Режим имитации: true — генерировать синтетические события без реального подключения.
    "SimulationMode": false
  },

  // ── Сервис записи фракталов ────────────────────────────────────────────────
  // Секция "Writer" → ArtasWriter.Application.Options.WriterOptions.
  "Writer": {
    // Список инструментов. Name совпадает с public.symbols.name
    // (код для Finam берётся из public.symbols.symbol). Все обрабатываются одним процессом.
    "Symbols": [
      { "Name": "Si" },
      { "Name": "MX" },
      { "Name": "IMOEXF" },
      { "Name": "CNY" },
      { "Name": "USDRUBF" },
      { "Name": "CNYRUBF" },
      { "Name": "MM" },
      { "Name": "RI" }
    ],
    // Порт health-эндпоинтов.
    "HealthPort": 8080,
    // Ёмкость канала событий продьюсера Finam (на каждый инструмент).
    // При переполнении вытесняются самые старые события (DropOldest).
    "ProducerChannelCapacity": 10000,
    // Ёмкость общего канала записи фракталов в БД (один на процесс).
    // При переполнении продьюсеры блокируются (backpressure).
    "WriterChannelCapacity": 10000,
    // Размер батча записи фракталов в PostgreSQL.
    "WriteBatchSize": 100,
    // Интервал сброса буфера записи, мс.
    "WriteFlushIntervalMs": 1000,
    // Размер буфера фракталов на инструмент.
    "FractalBufferSize": 500,
    // Endpoint OTLP-коллектора (метрики/трейсы OpenTelemetry). При отсутствии коллектора
    // экспорт асинхронный и не валит приложение.
    "OtlpEndpoint": "http://localhost:4317"
  },

  // ── Логирование ────────────────────────────────────────────────────────────
  // Секция "Logging" → стандартный конфиг Microsoft.Extensions.Logging.
  "Logging": {
    "LogLevel": {
      // Базовый уровень логирования.
      "Default": "Information",
      // Уровень логирования жизненного цикла host.
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
