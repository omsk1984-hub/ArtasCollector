<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtasWriter.Core\ArtasWriter.Core.csproj" />
    <ProjectReference Include="..\ArtasWriter.Application\ArtasWriter.Application.csproj" />
  </ItemGroup>

  <!--
    Finam Trade API proto-схемы (grpc/tradeapi/v1/...), скопированы из
    официального репозитория FinamWeb/finam-trade-api. Генерация клиентских
    заглушек для сервисов аутентификации и рыночных данных.
  -->
  <ItemGroup>
    <Protobuf Include="Protos\grpc\tradeapi\v1\marketdata\marketdata_service.proto" GrpcServices="Client" ProtoRoot="Protos" />
    <Protobuf Include="Protos\grpc\tradeapi\v1\auth\auth_service.proto" GrpcServices="Client" ProtoRoot="Protos" />
    <Protobuf Include="Protos\grpc\tradeapi\v1\side.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\google\api\annotations.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\google\api\http.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\google\type\decimal.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\google\type\interval.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\grpc\gateway\protoc_gen_openapiv2\options\annotations.proto" GrpcServices="None" ProtoRoot="Protos" />
    <Protobuf Include="Protos\grpc\gateway\protoc_gen_openapiv2\options\openapiv2.proto" GrpcServices="None" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
