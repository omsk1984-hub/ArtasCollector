# --- ArtasWriter (C#, .NET 10 + Finam Trade API, gRPC) ---
# Секретный ключ Finam (secret key, tapi_sk_...). НЕ коммитить!
# Используется Writer-ом для получения JWT через gRPC AuthService.Auth.
FINAM__TOKEN=tapi_sk_ЗАМЕНИТЕ_НА_СВОЙ_СЕКРЕТ

# MIC биржи по умолчанию для подписки (RTSX — фьючерсы MOEX FORTS, MISX — акции MOEX)
FINAM__DEFAULTMIC=RTSX

# Режим симуляции Finam (true — без реального подключения)
FINAM__SIMULATIONMODE=false

# Единый каталог логов (Writer/Stat пишут сюда, отсюда их собирает Promtail и
# отправляет в Loki). Если переменная не задана — используется <корень>/logs.
# Пример для Windows: D:\work\Artas2026\logs
LOGS_DIR=D:\work\Artas2026\logs

# Подключение Writer к PostgreSQL (секция Db в appsettings.json)
# Значения ниже переопределяют appsettings при наличии (Db__Host и т.п.):
# DB__HOST=127.0.0.1
# DB__PORT=5432
# DB__DATABASE=artas_db
# DB__USER=artas_user
# DB__PASSWORD=artas_password

# Конфигурация базы данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=artas_db
DB_USER=artas_user
DB_PASSWORD=artas_password
